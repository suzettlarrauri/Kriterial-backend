# Copiar a .env para desarrollo local. Nunca commitear .env ni claves reales.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

DATABASE_URL=postgresql://kriterial:kriterial_dev@127.0.0.1:55432/kriterial?schema=public
REDIS_URL=redis://127.0.0.1:56379

# Firma de tokens de acceso (HS256). Mínimo 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ISSUER=kriterial-api
JWT_AUDIENCE=kriterial

# Orígenes permitidos para CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173

# Raíz del registro de prompts (relativa al directorio del proyecto).
PROMPTS_DIR=prompts

# Almacenamiento local de audios (desarrollo). En producción: S3/R2 privado.
STORAGE_DIR=storage

# Transcripción: `fake` solo en desarrollo y pruebas.
TRANSCRIPTION_PROVIDER=fake

# LLM: `replay` no gasta API; `live` requiere ANTHROPIC_API_KEY.
LLM_MODE=replay
ANTHROPIC_API_KEY=
